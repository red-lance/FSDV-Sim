<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fs_autonomy</name>
  <version>0.1.0</version>
  <description>
    Formula Student autonomy nodes: mission controllers and visualization
    helpers. Developed against eufs_sim2 but kept free of any build dependency
    on the simulator itself -- only message packages cross the boundary, so
    the package deploys unchanged to embedded targets (Jetson).
  </description>
  <maintainer email="rishisatish@rivianvw.tech">rishi</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>eufs_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
